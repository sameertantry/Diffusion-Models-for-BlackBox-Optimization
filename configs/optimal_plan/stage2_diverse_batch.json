{
    "_description": "Stage-2: diverse_batch conditioning grid. Tests low_percentile width and high_offset. Main hope for STUCK_LOW_VARIANCE (multi-modal) functions.",
    "_grid": {
        "optimizer.conditioning.low_percentile": [0.5, 0.7],
        "optimizer.conditioning.high_offset": [0.1, 0.2]
    },
    "_grid_notes": "4 runs. low_pct=0.5 covers wide quality range (exploration across modes), low_pct=0.7 focuses on better half. high_offset=0.2 gives more extrapolation to push beyond current best.",
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "rm/optimal/stage-2/diverse_batch/sobol",
    "post_process": false,
    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,
        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,
        "batch_size": 128,
        "lr_diffusion": 0.001,
        "num_epochs": 100,
        "elite_min_per_dim": 32,
        "elite_max_per_dim": 128,
        "elite_filter": {
            "type": "quality"
        },
        "elite_adaptive": null,
        "precondition": {
            "type": "whiten_shrink"
        },
        "exploration": {
            "type": "sobol"
        },
        "local_search": {
            "enabled": false
        },
        "inference": {
            "type": "ddim",
            "eta": 0.5
        },
        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "diverse_batch",
            "low_percentile": 0.5,
            "high_offset": 0.15,
            "aug": false
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",
        "weight_decay": 0.0001,
        "x_noise_std": 0.01,
        "snr_loss_weighting": true,
        "snr_gamma": 5.0,
        "ema_decay": -1,
        "reinit_interval": 0,
        "reinit_epochs": 50,
        "seed": 42,
        "min_data_per_dim": 128,
        "verbose": true
    }
}
