{
    "_description": "Stage-2: combined conditioning grid. Annealed percentile centre + diverse batch spread. Tests how aggressively to anneal and how wide to spread.",
    "_grid": {
        "optimizer.conditioning.p_high": [0.90, 0.95],
        "optimizer.conditioning.low_quantile": [0.3, 0.5]
    },
    "_grid_notes": "4 runs. p_high=0.90 gives gentler annealing (max target = 90th percentile), p_high=0.95 pushes harder. low_quantile=0.3 gives wider within-batch spread for more exploration, 0.5 is narrower.",
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "rm/optimal/stage-2/combined",
    "post_process": false,
    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,
        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,
        "batch_size": 128,
        "lr_diffusion": 0.001,
        "num_epochs": 100,
        "elite_min_per_dim": 32,
        "elite_max_per_dim": 128,
        "elite_filter": {
            "type": "quality"
        },
        "elite_adaptive": null,
        "precondition": {
            "type": "whiten_shrink"
        },
        "exploration": {
            "type": "uniform"
        },
        "local_search": {
            "enabled": false
        },
        "inference": {
            "type": "ddim",
            "eta": 0.5
        },
        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "combined",
            "p_low": 0.60,
            "p_high": 0.90,
            "low_quantile": 0.30,
            "high_offset": 0.20,
            "aug": false
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",
        "weight_decay": 0.0001,
        "x_noise_std": 0.01,
        "snr_loss_weighting": true,
        "snr_gamma": 5.0,
        "ema_decay": -1,
        "reinit_interval": 0,
        "reinit_epochs": 50,
        "seed": 42,
        "min_data_per_dim": 128,
        "verbose": true
    }
}
