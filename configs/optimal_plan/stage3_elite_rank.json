{
    "_description": "Stage-3: elite filter (quality_knn) + rank_temperature. Base = S2 winner (db/sob/lp0.7/ho0.2). Tests if spatial diversity in the buffer and training focus help at dim=10.",
    "_grid": {
        "optimizer.elite_filter.diversity_weight": [0.3, 0.5],
        "optimizer.rank_temperature": [0.3, 0.5]
    },
    "_grid_notes": "4 runs. All use quality_knn. diversity_weight 0.3 = quality-dominated (70:30), 0.5 = balanced. rank_temp 0.3 = sharper training focus, 0.5 = default. S2 winner (quality, rt=0.5) is the baseline for comparison.",
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "rm/optimal/stage-3/elite_rank",
    "post_process": false,
    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,
        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,
        "batch_size": 128,
        "lr_diffusion": 0.001,
        "num_epochs": 100,
        "elite_min_per_dim": 32,
        "elite_max_per_dim": 128,
        "elite_filter": {
            "type": "quality_knn",
            "k": 5,
            "diversity_weight": 0.5
        },
        "elite_adaptive": null,
        "precondition": {
            "type": "whiten_shrink"
        },
        "exploration": {
            "type": "sobol"
        },
        "local_search": {
            "enabled": false
        },
        "inference": {
            "type": "ddim",
            "eta": 0.5
        },
        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "diverse_batch",
            "low_percentile": 0.7,
            "high_offset": 0.2,
            "aug": false
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",
        "weight_decay": 0.0001,
        "x_noise_std": 0.01,
        "snr_loss_weighting": true,
        "snr_gamma": 5.0,
        "ema_decay": -1,
        "reinit_interval": 0,
        "reinit_epochs": 50,
        "seed": 42,
        "min_data_per_dim": 128,
        "verbose": true
    }
}
