{
    "_description": "Stage-3: rank_temperature only (quality filter). Isolates effect of rank_temperature from elite filter change. S2 winner already has rt=0.5, so we only test rt=0.3.",
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "rm/optimal/stage-3/rank_only",
    "post_process": false,
    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,
        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,
        "batch_size": 128,
        "lr_diffusion": 0.001,
        "num_epochs": 100,
        "elite_min_per_dim": 32,
        "elite_max_per_dim": 128,
        "elite_filter": {
            "type": "quality"
        },
        "elite_adaptive": null,
        "precondition": {
            "type": "whiten_shrink"
        },
        "exploration": {
            "type": "sobol"
        },
        "local_search": {
            "enabled": false
        },
        "inference": {
            "type": "ddim",
            "eta": 0.5
        },
        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "diverse_batch",
            "low_percentile": 0.7,
            "high_offset": 0.2,
            "aug": false
        },
        "rank_temperature": 0.3,
        "y_norm_type": "rank",
        "weight_decay": 0.0001,
        "x_noise_std": 0.01,
        "snr_loss_weighting": true,
        "snr_gamma": 5.0,
        "ema_decay": -1,
        "reinit_interval": 0,
        "reinit_epochs": 50,
        "seed": 42,
        "min_data_per_dim": 128,
        "verbose": true
    }
}
