{
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "rm/ablation/A5_no_precondition",
    "post_process": false,
    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,
        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,
        "batch_size": 128,
        "lr_diffusion": 0.001,
        "num_epochs": 100,
        "elite_min_per_dim": 32,
        "elite_max_per_dim": 128,
        "elite_filter": {
            "type": "quality"
        },
        "elite_adaptive": null,
        "precondition": {
            "type": "none"
        },
        "exploration": {
            "type": "sobol"
        },
        "local_search": {
            "enabled": true,
            "frac": 0.15,
            "frac_max": 0.55,
            "anneal": true,
            "n_anchors": 5,
            "sigma_init": 0.2,
            "sigma_decay": "quadratic",
            "use_covariance": true,
            "anchor_selection": "elite_score"
        },
        "inference": {
            "type": "ddim",
            "eta": 0.5
        },
        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "diverse_batch",
            "low_percentile": 0.7,
            "high_offset": 0.2,
            "aug": false
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",
        "weight_decay": 0.0001,
        "x_noise_std": 0.01,
        "snr_loss_weighting": true,
        "snr_gamma": 5.0,
        "ema_decay": -1,
        "reinit_interval": 0,
        "reinit_epochs": 50,
        "seed": 42,
        "min_data_per_dim": 128,
        "verbose": true
    },
    "_description": "Ablation A5: Replace whiten_shrink with no preconditioning. Measures whiten_shrink contribution."
}
