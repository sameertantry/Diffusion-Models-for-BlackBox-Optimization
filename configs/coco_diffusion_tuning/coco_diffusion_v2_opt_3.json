{
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "DiffusionV2/opt-3-adaln-combined",
    "post_process": false,

    "_description": "Opt-3: AdaLN + combined conditioning — shrinkage whitening, LHS init, grid elite, combined conditioning with augmentation, AdaLN-ResNet with EMA",

    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,

        "noise_pred_arch": "adaln_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,

        "batch_size": 128,
        "lr_diffusion": 0.0003,
        "train_steps": 100,

        "elite_min_per_dim": 5,
        "elite_max_per_dim": 100,
        "elite_filter": {
            "type": "grid",
            "cells_per_dim": 5
        },
        "elite_adaptive": {
            "enabled": true,
            "floor_decay": 0.01,
            "floor_percentile": 5
        },

        "precondition": {
            "type": "whiten_shrink"
        },
        "exploration": {
            "type": "lhs"
        },

        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "combined",
            "p_low": 0.75,
            "p_high": 0.99,
            "low_quantile": 0.50,
            "high_offset": 0.1,
            "aug": true
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",

        "weight_decay": 0.0001,
        "x_noise_std": 0.01,

        "snr_loss_weighting": true,
        "snr_gamma": 5.0,

        "ema_decay": 0.995,

        "reinit_interval": 0,
        "reinit_train_steps": 200,

        "seed": 42,
        "min_data_per_dim": 10,
        "verbose": true
    }
}
