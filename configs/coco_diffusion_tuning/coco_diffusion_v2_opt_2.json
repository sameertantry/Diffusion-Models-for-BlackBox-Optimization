{
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "DiffusionV2/opt-2-diverse",
    "post_process": false,

    "_description": "Opt-2: Diverse — EMA whitening, Sobol init, crowding elite with adaptive sizing, diverse batch conditioning with augmentation",

    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,

        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,

        "batch_size": 128,
        "lr_diffusion": 0.0003,
        "num_epochs": 10,

        "elite_min_per_dim": 5,
        "elite_max_per_dim": 100,
        "elite_filter": {
            "type": "crowding",
            "n_tiers": 10
        },
        "elite_adaptive": {
            "enabled": true,
            "floor_decay": 0.02,
            "floor_percentile": 5
        },

        "precondition": {
            "type": "whiten_ema",
            "ema_rate": 0.1
        },
        "exploration": {
            "type": "sobol"
        },

        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "diverse_batch",
            "low_percentile": 0.5,
            "high_offset": 0.1,
            "aug": true
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",

        "weight_decay": 0.0001,
        "x_noise_std": 0.01,

        "snr_loss_weighting": true,
        "snr_gamma": 5.0,

        "ema_decay": -1,

        "reinit_interval": 0,
        "reinit_epochs": 50,

        "seed": 42,
        "min_data_per_dim": 10,
        "verbose": true
    }
}
