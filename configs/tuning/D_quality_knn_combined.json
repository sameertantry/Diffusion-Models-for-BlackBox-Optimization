{
    "method": "diffusion_v2",
    "algorithm_name": "DiffusionV2",
    "suite_name": "bbob",
    "suite_instance": "",
    "suite_options": "dimensions: 2,5,10 instance_indices: 1-2",
    "budget_multiplier": 1024,
    "eval_batch_size": 64,
    "precision": 0.1,
    "output_folder": "DiffusionV2/tuning-D-qknn-combined",
    "post_process": false,

    "_description": "Config D: Quality-KNN diverse elite buffer + Combined conditioning. Tests whether spatial diversity in the training set improves the learned distribution.",
    "_grid": {
        "optimizer.elite_filter.diversity_weight": [0.3, 0.7],
        "optimizer.conditioning.p_high":           [0.95, 0.99],
        "optimizer.rank_temperature":              [0.3, 0.8]
    },
    "_grid_notes": "diversity_weight: balance between quality and spatial coverage in the elite buffer (0.3=quality-dominated, 0.7=diversity-heavy). p_high: how ambitious the late-stage target gets. rank_temperature: how sharply training overweights the best points (0.3=sharp, 0.8=mild). Meaningful combos: high diversity_weight + mild rank_temp = spread-out training; low diversity_weight + sharp rank_temp = focused on best. 2×2×2 = 8 runs.",

    "optimizer": {
        "num_timesteps": 100,
        "beta_schedule": "squaredcos_cap_v2",
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.0,

        "noise_pred_arch": "film_resnet",
        "hidden_dim": 128,
        "time_embed_dim": 32,
        "depth": 3,

        "batch_size": 128,
        "lr_diffusion": 0.0003,
        "train_steps": 100,

        "elite_per_dim": 100,
        "elite_min": 64,
        "elite_filter": {
            "type": "quality_knn",
            "k": 5,
            "diversity_weight": 0.5
        },
        "elite_adaptive": null,
        "precondition": {"type": "none"},
        "exploration": {"type": "uniform"},

        "explore_frac": 0.05,
        "explore_anneal": true,
        "conditioning": {
            "type": "combined",
            "p_low": 0.75,
            "p_high": 0.99,
            "low_quantile": 0.50,
            "high_offset": 0.1,
            "aug": false
        },
        "rank_temperature": 0.5,
        "y_norm_type": "rank",

        "weight_decay": 0.0001,
        "x_noise_std": 0.01,

        "snr_loss_weighting": true,
        "snr_gamma": 5.0,

        "ema_decay": -1,

        "reinit_interval": 0,
        "reinit_train_steps": 200,

        "seed": 42,
        "min_data_per_dim": 10,
        "verbose": true
    }
}
